{
  "name": "music-hub",
  "version": "1.0.0",
  "description": "多平台音乐聚合客户端（播放器 + 插件化音源框架）",
  "main": "./out/main/index.js",
  "author": "Xiesta",
  "license": "GPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "sync:providers": "node scripts/sync-providers.mjs",
    "predev": "node scripts/sync-providers.mjs",
    "prebuild": "node scripts/sync-providers.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm run typecheck && electron-vite build",
    "build:dir": "pnpm run build && electron-builder --win --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "smoke": "electron . --smoke"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "music-metadata": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}